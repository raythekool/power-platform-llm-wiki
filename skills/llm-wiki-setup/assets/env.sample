# LLM Wiki — Environment Variables
# Copy this file to the project root as .env and fill in your values.

# ─── Azure DevOps ───────────────────────────────────────────────────
# Required for sync-devops operations.
# Generate a PAT at: https://dev.azure.com/<org>/_usersSettings/tokens
# Scope: Work Items (Read), Project (Read)
AZURE_DEVOPS_PAT=your-pat-here

# ─── GitHub ─────────────────────────────────────────────────────────
# Required for sync-github operations and gh CLI.
# The built-in GITHUB_TOKEN works in GitHub Actions.
# For local use: gh auth login (no extra token needed if gh is authenticated)
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-pat-here

# ─── SharePoint (optional) ─────────────────────────────────────────
# Required only if SharePoint sync is enabled.
# Register an app in Azure AD with Sites.Read.All permission.
TENANT_ID=your-tenant-id-here
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here
